.watch-head { display: flex; align-items: flex-end; justify-content: space-between; margin-bottom: 24rpx; }
.watch-head .section-title { font-size: 40rpx; font-weight: 900; }
.watch-item { margin-bottom: 10rpx; }
.watch-item .anime-row { margin-bottom: 0; border-radius: 14rpx 14rpx 0 0; border-bottom: 0; }
.watch-actions { display: flex; align-items: center; flex-wrap: wrap; background: #fff; border: 1rpx solid #e9e4e5; border-radius: 0 0 14rpx 14rpx; padding: 12rpx 16rpx 16rpx; margin-bottom: 16rpx; }
.watch-status-chip { font-size: 22rpx; color: #817b83; background: #f8f6f4; border: 1rpx solid #e9e4e5; border-radius: 999rpx; padding: 8rpx 20rpx; margin-right: 12rpx; }
.watch-status-chip.active { color: #fff; background: #f25c86; border-color: #f25c86; }
.watch-remove { margin-left: auto; font-size: 22rpx; color: #d94f6d; }
