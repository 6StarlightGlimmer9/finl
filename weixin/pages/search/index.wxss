.search-bar { display: flex; align-items: center; background: #fff; border: 1rpx solid #e9e4e5; border-radius: 12rpx; padding: 0 24rpx; min-height: 96rpx; }
.search-input { flex: 1; height: 96rpx; font-size: 30rpx; }
.search-clear { font-size: 24rpx; color: #817b83; padding: 0 16rpx; }
.search-submit { background: #f25c86; color: #fff; font-size: 28rpx; border-radius: 10rpx; padding: 20rpx 30rpx; }

.search-intro { margin-top: 32rpx; }
.filter-label { font-size: 22rpx; color: #a19aa2; margin: 8rpx 0 16rpx; }
.history-head { margin-top: 36rpx; }
.history-clear { font-size: 22rpx; color: #f25c86; }

.result-head { display: flex; align-items: flex-end; justify-content: space-between; margin: 40rpx 0 20rpx; }
.result-head .section-title { font-size: 32rpx; font-weight: 800; }
.result-comment { padding: 22rpx; margin-bottom: 16rpx; }
.result-author { margin-left: 16rpx; font-size: 26rpx; font-weight: 600; }
.result-text { font-size: 26rpx; color: #55505a; line-height: 1.7; margin: 14rpx 0; }
.result-anime { font-size: 22rpx; color: #f25c86; }
