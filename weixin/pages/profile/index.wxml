<view class="page">
  <view class="panel-dark profile-hero">
    <view class="avatar profile-avatar">{{initial}}</view>
    <view class="flex-1 profile-copy">
      <view class="profile-name">{{displayName}}</view>
      <view class="profile-meta" wx:if="{{loggedIn}}">@{{user.username}} <text wx:if="{{isAdmin}}" class="admin-badge">管理员</text></view>
      <view class="profile-meta" wx:else>登录后可评分、写长评、加入社群</view>
    </view>
    <view wx:if="{{!loggedIn}}" class="btn-primary btn-small" bindtap="goLogin">登录</view>
  </view>

  <view wx:if="{{loggedIn}}" class="card profile-stats">
    <view><text class="stat-num">{{profile.ratingCount || 0}}</text><text class="stat-label">次评分</text></view>
    <view><text class="stat-num">{{profile.commentCount || 0}}</text><text class="stat-label">条短评</text></view>
    <view><text class="stat-num">{{profile.watchlistCount || 0}}</text><text class="stat-label">部片单</text></view>
  </view>

  <view class="quick-grid">
    <view class="quick-item" bindtap="goWatchlist"><view class="quick-icon">单</view><text>我的片单</text></view>
    <view class="quick-item" bindtap="goSearch"><view class="quick-icon">搜</view><text>全站搜索</text></view>
    <view class="quick-item" bindtap="goTab" data-url="/pages/reviews/index"><view class="quick-icon">评</view><text>长评广场</text></view>
    <view class="quick-item" bindtap="goTab" data-url="/pages/community/index"><view class="quick-icon">群</view><text>同好社群</text></view>
  </view>

  <block wx:if="{{loggedIn}}">
    <view wx:if="{{error}}" class="empty">
      <view>{{error}}</view>
      <view class="btn-ghost btn-small empty-cta" bindtap="loadProfile">重新加载</view>
    </view>
    <view wx:if="{{loading && !profile}}" class="loading">正在整理你的记录…</view>

    <view class="chip-row record-tabs">
      <view wx:for="{{sections}}" wx:key="value" class="chip pink {{section === item.value ? 'active' : ''}}" data-value="{{item.value}}" bindtap="switchSection">{{item.label}}</view>
    </view>

    <block wx:if="{{profile}}">
      <block wx:if="{{section === 'ratings'}}">
        <view wx:if="{{!profile.ratings.length}}" class="empty">还没有评分记录，去片库挑一部吧</view>
        <view class="card record-row" wx:for="{{profile.ratings}}" wx:key="animeId" data-id="{{item.animeId}}" bindtap="openDetail">
          <image class="record-cover" src="{{item.cover}}" mode="aspectFill" lazy-load="true" />
          <view class="flex-1">
            <view class="record-title ellipsis">{{item.title}}</view>
            <view class="sub">{{item.time}} · 我给了 {{item.score}} 分</view>
          </view>
          <view class="record-score score">{{item.scoreText}}</view>
        </view>
      </block>

      <block wx:if="{{section === 'comments'}}">
        <view wx:if="{{!profile.comments.length}}" class="empty">还没有短评记录</view>
        <view class="card record-comment" wx:for="{{profile.comments}}" wx:key="id">
          <view class="record-title">{{item.content}}</view>
          <view class="sub" data-id="{{item.animeId}}" catchtap="openDetail">《{{item.animeTitle}}》 · {{item.time}} ›</view>
        </view>
      </block>

      <block wx:if="{{section === 'watchlist'}}">
        <view wx:if="{{!profile.watchlist.length}}" class="empty">片单还是空的</view>
        <view class="card record-row" wx:for="{{profile.watchlist}}" wx:key="animeId" data-id="{{item.animeId}}" bindtap="openDetail">
          <image class="record-cover" src="{{item.cover}}" mode="aspectFill" lazy-load="true" />
          <view class="flex-1">
            <view class="record-title ellipsis">{{item.title}}</view>
            <view class="sub">{{item.statusLabel}}</view>
          </view>
          <view class="record-score score">{{item.scoreText}}</view>
        </view>
      </block>
    </block>
  </block>

  <view class="card settings-card">
    <view class="settings-row" bindtap="openServer">
      <text class="flex-1">连接设置</text><text class="sub">后端 / 图片地址</text><text class="settings-arrow">›</text>
    </view>
    <view class="settings-row" wx:if="{{loggedIn}}" bindtap="logout">
      <text class="flex-1 logout-text">退出登录</text><text class="settings-arrow">›</text>
    </view>
  </view>

  <view wx:if="{{serverOpen}}" class="modal-mask" bindtap="closeServer"></view>
  <view wx:if="{{serverOpen}}" class="modal-panel" catchtap="noop">
    <view class="modal-head">
      <view class="modal-title">连接设置</view>
      <view class="modal-close" bindtap="closeServer">×</view>
    </view>
    <view class="form-label">接口地址（含 /api）</view>
    <input class="form-input" placeholder="请输入接口地址" value="{{apiBase}}" data-field="apiBase" bindinput="onServerInput" />
    <view class="form-label">图片地址</view>
    <input class="form-input" placeholder="请输入图片地址" value="{{imgHost}}" data-field="imgHost" bindinput="onServerInput" />
    <view class="modal-actions">
      <view class="btn-ghost" bindtap="resetServer">恢复默认</view>
      <view class="btn-primary" bindtap="saveServer">保存</view>
    </view>
  </view>
</view>
