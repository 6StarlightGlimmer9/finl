/**app.wxss · 与 Web 端保持一致的粉 + 墨色主题**/
page {
  --pink: #f25c86;
  --pink-soft: #fff0f4;
  --ink: #17151a;
  --muted: #817b83;
  --line: #e9e4e5;
  --bg: #f8f6f4;
  --gold: #e99537;
  --tabbar-total: calc(104rpx + env(safe-area-inset-bottom));
  background: var(--bg, #f8f6f4);
  color: var(--ink, #17151a);
  font-size: 28rpx;
  line-height: 1.55;
  font-family: -apple-system, BlinkMacSystemFont, 'PingFang SC', 'Microsoft YaHei', sans-serif;
}

view, text, input, textarea, image, scroll-view { box-sizing: border-box; }

.page { min-height: 100vh; padding: 24rpx 24rpx calc(var(--tabbar-total, 172rpx) + 48rpx); animation: page-fade .28s ease backwards; }
.card { background: #fff; border: 1rpx solid var(--line, #e9e4e5); border-radius: 16rpx; padding: 24rpx; }
.card + .card { margin-top: 20rpx; }
.section { margin-top: 44rpx; }
.section-head { display: flex; align-items: flex-end; justify-content: space-between; margin-bottom: 20rpx; }
.eyebrow { font-size: 20rpx; letter-spacing: 3rpx; color: var(--pink, #f25c86); font-weight: 700; }
.section-title { font-size: 36rpx; font-weight: 800; margin-top: 4rpx; }
.section-more { font-size: 24rpx; color: var(--pink, #f25c86); }
.sub { font-size: 24rpx; color: var(--muted, #817b83); }
.muted { color: var(--muted, #817b83); }
.score { color: var(--gold, #e99537); font-weight: 700; }
.ellipsis { overflow: hidden; white-space: nowrap; text-overflow: ellipsis; }
.clamp-2 { display: -webkit-box; -webkit-box-orient: vertical; -webkit-line-clamp: 2; overflow: hidden; }
.clamp-3 { display: -webkit-box; -webkit-box-orient: vertical; -webkit-line-clamp: 3; overflow: hidden; }
.divider { height: 1rpx; background: var(--line, #e9e4e5); margin: 20rpx 0; }
.row { display: flex; align-items: center; }
.row-between { display: flex; align-items: center; justify-content: space-between; }
.flex-1 { flex: 1; min-width: 0; }

.tag { display: inline-block; font-size: 20rpx; color: #bf4a70; background: var(--pink-soft, #fff0f4); padding: 4rpx 12rpx; border-radius: 6rpx; margin: 0 10rpx 10rpx 0; }
.chip-row { display: flex; flex-wrap: wrap; }
.chip { display: inline-flex; align-items: center; font-size: 24rpx; color: #6f6870; background: #fff; border: 1rpx solid var(--line, #e9e4e5); border-radius: 999rpx; padding: 10rpx 24rpx; margin: 0 12rpx 12rpx 0; }
.chip.active { background: var(--ink, #17151a); border-color: var(--ink, #17151a); color: #fff; }
.chip.pink.active { background: var(--pink, #f25c86); border-color: var(--pink, #f25c86); }

.btn-primary, .btn-ghost, .btn-dark { display: flex; align-items: center; justify-content: center; border-radius: 10rpx; font-size: 28rpx; font-weight: 600; padding: 20rpx 28rpx; }
.btn-primary { background: var(--pink, #f25c86); color: #fff; }
.btn-dark { background: var(--ink, #17151a); color: #fff; }
.btn-ghost { background: #fff; border: 1rpx solid var(--line, #e9e4e5); color: var(--ink, #17151a); }
.btn-small { font-size: 22rpx; padding: 10rpx 20rpx; border-radius: 8rpx; }
.btn-block { width: 100%; }
.btn-disabled { opacity: .55; }

.avatar { width: 56rpx; height: 56rpx; flex: none; border-radius: 50%; background: var(--ink, #17151a); color: #fff; display: flex; align-items: center; justify-content: center; font-size: 24rpx; font-weight: 700; }
.avatar.pink { background: #f7d9e3; color: #bf4a70; }
.loading, .empty { padding: 60rpx 20rpx; text-align: center; color: var(--muted, #817b83); font-size: 26rpx; }
.empty-cta { margin: 24rpx auto 0; width: 260rpx; }
.state-line { text-align: center; color: var(--muted, #817b83); font-size: 24rpx; padding: 28rpx 0; }

/* 通用海报卡片 / 横向作品行（模板：templates/cards.wxml） */
.poster-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20rpx; }
.poster-card { min-width: 0; background: #fff; border: 1rpx solid var(--line, #e9e4e5); border-radius: 14rpx; overflow: hidden; }
.poster-cover { position: relative; width: 100%; height: 280rpx; background: linear-gradient(135deg, #f3d8e0, #2a2028); }
.poster-cover image { width: 100%; height: 100%; display: block; }
.poster-score { position: absolute; right: 10rpx; top: 10rpx; padding: 4rpx 10rpx; border-radius: 8rpx; background: rgba(23, 21, 26, .72); color: #ffca6b; font-size: 22rpx; font-weight: 700; }
.poster-title { padding: 12rpx 12rpx 0; font-size: 26rpx; font-weight: 600; }
.poster-meta { padding: 2rpx 12rpx 14rpx; font-size: 20rpx; color: var(--muted, #817b83); }
.poster-title, .poster-meta { overflow: hidden; white-space: nowrap; text-overflow: ellipsis; }

.anime-row { display: flex; align-items: center; background: #fff; border: 1rpx solid var(--line, #e9e4e5); border-radius: 14rpx; padding: 16rpx; margin-bottom: 16rpx; }
.anime-row-cover { width: 132rpx; height: 178rpx; flex: none; border-radius: 10rpx; background: #2a2028; }
.anime-row-body { flex: 1; min-width: 0; padding: 0 16rpx; }
.anime-row-title { font-size: 30rpx; font-weight: 700; overflow: hidden; white-space: nowrap; text-overflow: ellipsis; }
.anime-row-meta { font-size: 22rpx; color: var(--muted, #817b83); margin: 8rpx 0; overflow: hidden; white-space: nowrap; text-overflow: ellipsis; }
.anime-row-score { flex: none; font-size: 30rpx; color: var(--gold, #e99537); font-weight: 800; }
.mini-tag { display: inline-block; font-size: 20rpx; color: #bf4a70; background: var(--pink-soft, #fff0f4); border-radius: 6rpx; padding: 2rpx 10rpx; margin: 0 8rpx 8rpx 0; }

/* 弹层与表单 */
.modal-mask { position: fixed; left: 0; right: 0; top: 0; bottom: 0; background: rgba(23, 21, 26, .55); z-index: 1000; }
.modal-panel { position: fixed; left: 0; right: 0; bottom: 0; z-index: 1001; background: #fff; border-radius: 28rpx 28rpx 0 0; padding: 32rpx 28rpx calc(40rpx + env(safe-area-inset-bottom)); max-height: 86vh; overflow-y: auto; }
.modal-head { display: flex; align-items: center; justify-content: space-between; margin-bottom: 26rpx; }
.modal-title { font-size: 34rpx; font-weight: 800; }
.modal-close { font-size: 40rpx; color: var(--muted, #817b83); line-height: 1; padding: 0 12rpx; }
.form-label { display: block; font-size: 26rpx; color: var(--muted, #817b83); margin: 24rpx 0 12rpx; }
.form-input, .form-textarea, .form-picker { width: 100%; min-height: 96rpx; background: #f8f6f4; border: 1rpx solid var(--line, #e9e4e5); border-radius: 12rpx; padding: 24rpx; font-size: 30rpx; line-height: 1.5; }
.form-textarea { min-height: 260rpx; height: 260rpx; }
.form-picker { display: flex; align-items: center; color: var(--ink, #17151a); }
.modal-actions { display: flex; gap: 16rpx; margin-top: 32rpx; }
.modal-actions > view { flex: 1; }

.panel-dark { background: var(--ink, #17151a); color: #fff; border-radius: 16rpx; padding: 28rpx; }
.panel-dark .eyebrow { color: #ff9ec0; }

/* 页面与交互动效 */
@keyframes page-fade { 0% { opacity: 0 } 100% { opacity: 1 } }
@keyframes rise-in { 0% { opacity: 0; transform: translateY(18rpx) } 100% { opacity: 1; transform: translateY(0) } }
@keyframes mask-in { 0% { opacity: 0 } 100% { opacity: 1 } }
@keyframes panel-up { 0% { transform: translateY(100%) } 100% { transform: translateY(0) } }

.card, .panel-dark, .poster-card, .anime-row, .entry, .rank-row, .review-card, .topic-card,
.group-card, .event-card, .community-comment, .comment-item, .watch-item, .record-row,
.record-comment, .post-card, .hot-item { animation: rise-in .42s cubic-bezier(.22, .61, .36, 1) backwards; }

.poster-grid .poster-card:nth-child(2), .entry-grid .entry:nth-child(2) { animation-delay: .05s }
.poster-grid .poster-card:nth-child(3), .entry-grid .entry:nth-child(3) { animation-delay: .1s }
.poster-grid .poster-card:nth-child(4), .entry-grid .entry:nth-child(4) { animation-delay: .15s }
.poster-grid .poster-card:nth-child(5), .entry-grid .entry:nth-child(5) { animation-delay: .2s }
.poster-grid .poster-card:nth-child(6), .entry-grid .entry:nth-child(6) { animation-delay: .25s }

.modal-mask { animation: mask-in .22s ease backwards; }
.modal-panel { animation: panel-up .3s cubic-bezier(.22, .61, .36, 1) backwards; }

.btn-primary, .btn-ghost, .btn-dark, .chip, .like-button, .comment-like,
.watch-status-chip, .group-join, .write-fab, .entry, .poster-card, .anime-row,
.rank-row, .topic-card, .review-card {
  transition: transform .18s ease, opacity .18s ease, background-color .22s ease, color .22s ease, box-shadow .22s ease;
}

.btn-primary:active, .btn-ghost:active, .btn-dark:active, .chip:active,
.like-button:active, .comment-like:active, .watch-status-chip:active,
.group-join:active, .write-fab:active, .entry:active, .poster-card:active,
.anime-row:active { transform: scale(.97); opacity: .88; }

.tap-hover { opacity: .85; transform: scale(.97); }

