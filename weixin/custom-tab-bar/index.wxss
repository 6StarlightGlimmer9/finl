.tab-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 999;
  display: flex;
  background: #fff;
  border-top: 1rpx solid #ece7e8;
  padding-bottom: env(safe-area-inset-bottom);
}

.tab-item {
  flex: 1;
  height: 104rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: #8b848b;
}

.tab-item.active { color: #f25c86; }
.tab-text { font-size: 22rpx; line-height: 1.2; }

/* iconfont 风格图标：用 currentColor 绘制，选中时自动套用主题色 */
.tab-icon { position: relative; width: 44rpx; height: 44rpx; margin-bottom: 4rpx; }
.tab-icon::before,
.tab-icon::after { content: ''; position: absolute; box-sizing: border-box; }

.ic-home::before { left: 7rpx; bottom: 3rpx; width: 30rpx; height: 22rpx; border: 3rpx solid currentColor; border-top: 0; border-radius: 0 0 4rpx 4rpx; }
.ic-home::after { left: 2rpx; top: 3rpx; width: 0; height: 0; border-left: 20rpx solid transparent; border-right: 20rpx solid transparent; border-bottom: 18rpx solid currentColor; }

.ic-anime::before { left: 3rpx; top: 8rpx; width: 38rpx; height: 30rpx; border: 3rpx solid currentColor; border-radius: 6rpx; }
.ic-anime::after { left: 17rpx; top: 15rpx; width: 0; height: 0; border-left: 11rpx solid currentColor; border-top: 7rpx solid transparent; border-bottom: 7rpx solid transparent; }

.ic-review::before { left: 7rpx; top: 3rpx; width: 30rpx; height: 38rpx; border: 3rpx solid currentColor; border-radius: 4rpx; }
.ic-review::after { left: 13rpx; top: 13rpx; width: 18rpx; height: 3rpx; background: currentColor; box-shadow: 0 9rpx 0 currentColor, 0 18rpx 0 currentColor; }

.ic-community::before { left: 17rpx; top: 2rpx; width: 14rpx; height: 14rpx; border-radius: 50%; background: currentColor; box-shadow: -13rpx 7rpx 0 -2rpx currentColor, 13rpx 7rpx 0 -2rpx currentColor; }
.ic-community::after { left: 4rpx; bottom: 3rpx; width: 36rpx; height: 16rpx; border-radius: 16rpx 16rpx 6rpx 6rpx; background: currentColor; }

.ic-profile::before { left: 15rpx; top: 3rpx; width: 16rpx; height: 16rpx; border-radius: 50%; border: 3rpx solid currentColor; }
.ic-profile::after { left: 8rpx; bottom: 3rpx; width: 30rpx; height: 16rpx; border: 3rpx solid currentColor; border-bottom: 0; border-radius: 16rpx 16rpx 0 0; }

/* 切换 Tab 时图标轻微弹起、文字与图标颜色渐变 */
@keyframes tab-icon-pop { 0% { transform: scale(.82) translateY(4rpx) } 60% { transform: scale(1.16) translateY(-4rpx) } 100% { transform: scale(1.08) translateY(-2rpx) } }
.tab-item { transition: color .22s ease; }
.tab-icon, .tab-text { transition: color .22s ease, transform .22s ease; }
.tab-item.active .tab-icon { transform: scale(1.08) translateY(-2rpx); animation: tab-icon-pop .34s ease both; }
.tab-hover { opacity: .6; }
